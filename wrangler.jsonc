{
  // https://vendling.dev — the Vendling developer docs, static assets only.
  // Built by `python3 scripts/build.py` into dist/, deployed by
  // `npx wrangler deploy` (CI does this on every push to main). The zone
  // vendling.dev lives in the same Cloudflare account, so the custom_domain
  // routes get their DNS records and certificates from wrangler.
  "$schema": "node_modules/wrangler/config-schema.json",
  // 原名 vendling-dev，2026-09-14 改名：仓库 fxp/vendling-dev 是项目管理 Agent，
  // 跟这个文档站是两回事，同名会让人在 Cloudflare 控制台上认错。
  "name": "vendling-docs",
  "account_id": "0356d59ccdcff356bf3bbdb580bbaa60",
  "compatibility_date": "2026-08-01",
  "assets": {
    "directory": "./dist",
    // /api/reference serves reference.html, /api/skill/ serves index.html.
    "html_handling": "auto-trailing-slash",
    "not_found_handling": "404-page"
  },
  // ── BACK ONLINE 2026-09-14 ──────────────────────────────────────────
  // Offline from 2026-09-11 (routes detached at the owner's request); this
  // Worker is stateless — it serves a build of spec/ + openapi/ — so
  // nothing was lost by detaching the domain, and restoring the routes
  // below plus `wrangler deploy` puts it straight back. Restored together
  // with vendling-core (vendling.xiaopingfeng.com), the API this site
  // documents.
  "routes": [
    { "pattern": "vendling.dev", "custom_domain": true },
    { "pattern": "www.vendling.dev", "custom_domain": true }
  ],
  "workers_dev": false
}
